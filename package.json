{
  "name": "@brkn-labs/judge",
  "version": "0.0.0",
  "description": "Probabilistic judgment. Deterministic execution.",
  "homepage": "https://github.com/Illusion47586/judge#readme",
  "bugs": {
    "url": "https://github.com/Illusion47586/judge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Illusion47586/judge.git"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./gateway/custom": {
      "types": "./dist/gateway/custom.d.ts",
      "import": "./dist/gateway/custom.js"
    },
    "./gateway/vercel": {
      "types": "./dist/gateway/vercel.d.ts",
      "import": "./dist/gateway/vercel.js"
    },
    "./gateway/cloudflare": {
      "types": "./dist/gateway/cloudflare.d.ts",
      "import": "./dist/gateway/cloudflare.js"
    },
    "./gateway/openrouter": {
      "types": "./dist/gateway/openrouter.d.ts",
      "import": "./dist/gateway/openrouter.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check": "npm run lint && npm run typecheck && npm run typecheck:contracts && npm run typecheck:examples && npm run test:unit",
    "clean": "node --eval \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "commitlint": "commitlint",
    "example:agent": "npm run build --silent && node --env-file=.env examples/09-agent-tool-routing.ts",
    "example:all": "npm run build --silent && node scripts/run-examples.ts",
    "example:boolean": "npm run build --silent && node --env-file=.env examples/01-boolean.ts",
    "example:choice": "npm run build --silent && node --env-file=.env examples/03-choice.ts",
    "example:if": "npm run build --silent && node --env-file=.env examples/02-if.ts",
    "example:incident": "npm run build --silent && node --env-file=.env examples/08-incident-escalation.ts",
    "example:risk": "npm run build --silent && node --env-file=.env examples/07-transaction-risk.ts",
    "example:score": "npm run build --silent && node --env-file=.env examples/05-score.ts",
    "example:support": "npm run build --silent && node --env-file=.env examples/06-support-triage.ts",
    "example:switch": "npm run build --silent && node --env-file=.env examples/04-switch.ts",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "npm run build && changeset publish",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "test:unit": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "npm run build --silent && tsc --noEmit -p tsconfig.type-contracts.json",
    "typecheck:examples": "npm run build --silent && tsc --noEmit -p tsconfig.examples.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.87",
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.6.1",
    "ai": "^7.0.107",
    "cloudflare": "^7.1.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0"
  },
  "peerDependencies": {
    "@ai-sdk/gateway": "^4.0.87",
    "ai": "^7.0.107",
    "cloudflare": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/gateway": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "cloudflare": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
